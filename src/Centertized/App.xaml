<Application x:Class="Centertized.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Without this the WPF-UI controls (FluentWindow, NavigationView...)
                          have no template at all and their inner parts stay null –
                          SystemThemeWatcher then only fine-tunes colors/backdrop live,
                          the styles/templates themselves must come from ControlsDictionary. -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- The app has no main window – the tray icon lives as a resource and must be
                      explicitly "created" at app start (see App.xaml.cs, ForceCreate). -->
            <tb:TaskbarIcon x:Key="TrayIcon" ToolTipText="Centertized"
                            TrayLeftMouseDoubleClick="TrayIcon_DoubleClick"
                            TrayRightMouseUp="TrayIcon_RightClick">
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
