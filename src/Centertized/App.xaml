<Application x:Class="Centertized.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Bez tohohle nemají WPF-UI controly (FluentWindow, NavigationView...)
                     vůbec žádný template a jejich vnitřní části zůstanou null –
                     SystemThemeWatcher pak jen dolaďuje barvy/backdrop naživo,
                     samotné styly/šablony sem musí dodat ControlsDictionary. -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Appka nemá hlavní okno – ikona v tray liště žije jako zdroj a musí se
                 ve startu appky explicitně "vytvořit" (viz App.xaml.cs, ForceCreate). -->
            <tb:TaskbarIcon x:Key="TrayIcon" ToolTipText="Centertized"
                            TrayLeftMouseDoubleClick="TrayIcon_DoubleClick">
                <tb:TaskbarIcon.ContextMenu>
                    <!-- Obyčejný ContextMenu/MenuItem si WPF-UI implicitně neobarví
                         (na rozdíl od třeba ComboBoxu/ToggleSwitche) - explicitní
                         theme-aware barvy, ať to není bílé i v dark režimu. -->
                    <ContextMenu Background="{ui:ThemeResource ApplicationBackgroundBrush}"
                                 Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                 BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}">
                        <!-- ui:MenuItem, ne obyčejný MenuItem - má vlastní Fluent styl
                             (zaoblený hover bez rámečku, správně vystředěná ikona). -->
                        <ui:MenuItem Header="Settings" Click="SettingsMenuItem_Click">
                            <ui:MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Settings20" />
                            </ui:MenuItem.Icon>
                        </ui:MenuItem>
                        <Separator />
                        <ui:MenuItem Header="Exit" Click="ExitMenuItem_Click">
                            <ui:MenuItem.Icon>
                                <ui:SymbolIcon Symbol="ArrowExit20" />
                            </ui:MenuItem.Icon>
                        </ui:MenuItem>
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
