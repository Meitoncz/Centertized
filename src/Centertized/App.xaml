<Application x:Class="Centertized.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Appka nemá hlavní okno – ikona v tray liště žije jako zdroj a musí se
             ve startu appky explicitně "vytvořit" (viz App.xaml.cs, ForceCreate). -->
        <tb:TaskbarIcon x:Key="TrayIcon" ToolTipText="Centertized">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Konec" Click="ExitMenuItem_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
