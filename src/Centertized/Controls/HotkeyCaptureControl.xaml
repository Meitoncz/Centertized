<UserControl x:Class="Centertized.Controls.HotkeyCaptureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             HorizontalAlignment="Right">
    <!-- A Button, not a plain Border - we need reliable clicking/focus in
              any container (CardControl etc.), not a manual PreviewMouseLeftButtonDown.
              Fixed width so the card doesn't jump between "Not set" and a long shortcut. -->
    <Button x:Name="CaptureButton"
            Width="190">
        <!-- A TextBlock with trimming as a safeguard for longer messages (conflicts etc.),
                  not just Button.Content as a bare string. -->
        <TextBlock Text="{Binding DisplayText, ElementName=Root}"
                   TextTrimming="CharacterEllipsis"
                   TextAlignment="Center" />
    </Button>
</UserControl>
