<UserControl x:Class="Centertized.Controls.HotkeyCaptureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             HorizontalAlignment="Right">
    <!-- Button, ne obyčejný Border - potřebujeme spolehlivé klikání/fokus v
         jakémkoliv kontejneru (CardControl apod.), ne ruční PreviewMouseLeftButtonDown.
         Pevná šířka, ať karta neposkakuje mezi "Not set" a dlouhou zkratkou. -->
    <Button x:Name="CaptureButton"
            Width="190"
            PreviewKeyDown="OnPreviewKeyDown">
        <!-- TextBlock s trimováním jako pojistka pro delší hlášky (konflikty apod.),
             ne jen Button.Content jako holý string. -->
        <TextBlock Text="{Binding DisplayText, ElementName=Root}"
                   TextTrimming="CharacterEllipsis"
                   TextAlignment="Center" />
    </Button>
</UserControl>
