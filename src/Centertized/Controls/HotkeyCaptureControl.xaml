<UserControl x:Class="Centertized.Controls.HotkeyCaptureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="True"
             MinWidth="240">
    <Border x:Name="RootBorder"
            BorderThickness="1"
            BorderBrush="Gray"
            CornerRadius="4"
            Padding="10,6"
            Background="Transparent">
        <TextBlock Text="{Binding DisplayText, ElementName=Root}"
                   HorizontalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
    </Border>
</UserControl>
