    <sys:String x:Key="Section.About">Info</sys:String>

    <sys:String x:Key="Action.center-active-window.Name">Aktives Fenster zentrieren</sys:String>
    <sys:String x:Key="Action.center-active-window.Description">Zentriert das aktive Fenster auf seinem aktuellen Monitor.</sys:String>
    <sys:String x:Key="Action.toggle-maximize-active-window.Name">Aktives Fenster maximieren/wiederherstellen</sys:String>
    <sys:String x:Key="Action.toggle-maximize-active-window.Description">Maximiert das aktive Fenster; erneutes Drücken stellt Größe und Position wieder her.</sys:String>

    <sys:String x:Key="General.StartWithWindows">Mit Windows starten</sys:String>
    <sys:String x:Key="General.StartMinimized">Minimiert starten</sys:String>
    <sys:String x:Key="General.StartMinimized.Description">Dieses Fenster beim Start der App nicht anzeigen</sys:String>
    <sys:String x:Key="General.AutoCenter">Neue Fenster automatisch zentrieren</sys:String>
    <sys:String x:Key="General.AutoCenter.Description">Zentriert jedes neu geöffnete Fenster automatisch auf seinem Monitor</sys:String>
    <sys:String x:Key="General.RememberSizes">Fenstergrößen merken</sys:String>
    <sys:String x:Key="General.RememberSizes.Description">Fenster einer App öffnen sich in der Größe, die Sie ihnen zuletzt gegeben haben. Funktioniert zusammen mit dem automatischen Zentrieren.</sys:String>
    <sys:String x:Key="General.RememberSizes.Forget">Alle Größen vergessen</sys:String>
    <sys:String x:Key="General.RunAsAdmin">Als Administrator ausführen</sys:String>
    <sys:String x:Key="General.RunAsAdmin.Description">Ermöglicht Centertized, Fenster von Apps zu verschieben, die als Administrator laufen. Windows fragt nach einer Bestätigung (UAC), und Centertized wird neu gestartet.</sys:String>
    <sys:String x:Key="General.Theme">Design</sys:String>
    <sys:String x:Key="General.Theme.Description">Hell, dunkel oder wie Windows</sys:String>
    <sys:String x:Key="General.Theme.System">System</sys:String>
    <sys:String x:Key="General.Theme.Light">Hell</sys:String>
    <sys:String x:Key="General.Theme.Dark">Dunkel</sys:String>
    <sys:String x:Key="General.Language">Sprache</sys:String>
    <sys:String x:Key="General.Language.Description">Sprache der App</sys:String>
    <sys:String x:Key="General.Language.System">System</sys:String>

    <sys:String x:Key="Exceptions.Intro">Neue Fenster dieser Apps werden nicht automatisch zentriert.</sys:String>
    <sys:String x:Key="Exceptions.Choose">Apps auswählen…</sys:String>
    <sys:String x:Key="Exceptions.Empty">Keine Ausnahmen.</sys:String>
    <sys:String x:Key="Exceptions.Remove">Entfernen</sys:String>

    <sys:String x:Key="Picker.Title">Apps auswählen</sys:String>
