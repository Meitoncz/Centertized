    <sys:String x:Key="About.License">Lizenz: GPLv3</sys:String>
    <sys:String x:Key="About.Close">Schließen</sys:String>

    <sys:String x:Key="Update.Title">Updates</sys:String>
    <sys:String x:Key="Update.Automatic">Automatisch nach Updates suchen</sys:String>
    <sys:String x:Key="Update.Automatic.Description">Sucht beim Start der App nach einer neuen Version</sys:String>
