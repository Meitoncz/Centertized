    <sys:String x:Key="Picker.Done">Fertig</sys:String>
    <sys:String x:Key="Picker.Cancel">Abbrechen</sys:String>

    <sys:String x:Key="About.Description">Ein natives Windows-Infobereich-Tool zur Fensterverwaltung, zunächst mit Zentrieren des aktiven Fensters.</sys:String>
    <sys:String x:Key="About.Version">Version {0}</sys:String>
