    <sys:String x:Key="Update.Checking">Suche läuft…</sys:String>
    <sys:String x:Key="Update.UpToDate">Sie haben die neueste Version.</sys:String>
    <sys:String x:Key="Update.Available">Version {0} ist verfügbar.</sys:String>
    <sys:String x:Key="Update.Download">Herunterladen und neu starten</sys:String>
    <sys:String x:Key="Update.Downloading">Wird heruntergeladen…</sys:String>
    <sys:String x:Key="Update.Failed">Die Suche nach Updates ist fehlgeschlagen.</sys:String>
    <sys:String x:Key="Update.NotInstalled">Updates funktionieren nur in der installierten Version von Centertized.</sys:String>

    <sys:String x:Key="Hotkey.NotSet">Nicht festgelegt</sys:String>
    <sys:String x:Key="Hotkey.NeedsModifier">Benötigt Strg/Alt/Umschalt/Win</sys:String>
    <sys:String x:Key="Hotkey.UsedBy">Belegt durch {0}</sys:String>
    <sys:String x:Key="Hotkey.UsedElsewhere">Von einer anderen App belegt</sys:String>

    <sys:String x:Key="Tray.Open">Centertized öffnen</sys:String>
    <sys:String x:Key="Tray.About">Info</sys:String>
    <sys:String x:Key="Tray.Close">Beenden</sys:String>
    <sys:String x:Key="Tray.StillRunning">Läuft weiter im Infobereich. Klicken Sie jederzeit auf das Symbol, um die Einstellungen wieder zu öffnen.</sys:String>

    <sys:String x:Key="Notice.UpdateAvailable">Version {0} ist verfügbar. Öffnen Sie die Einstellungen zum Aktualisieren.</sys:String>
</ResourceDictionary>
