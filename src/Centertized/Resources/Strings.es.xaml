    <sys:String x:Key="Action.toggle-maximize-active-window.Name">Maximizar o restaurar la ventana activa</sys:String>
    <sys:String x:Key="Action.toggle-maximize-active-window.Description">Maximiza la ventana activa; al volver a pulsarlo, restaura el tamaño y la posición anteriores.</sys:String>

