    <sys:String x:Key="Hotkey.UsedElsewhere">Utilisé par une autre application</sys:String>

    <sys:String x:Key="Tray.Open">Ouvrir Centertized</sys:String>
    <sys:String x:Key="Tray.About">À propos</sys:String>
    <sys:String x:Key="Tray.Close">Fermer</sys:String>
    <sys:String x:Key="Tray.StillRunning">Toujours en cours d'exécution dans la zone de notification. Cliquez sur l'icône à tout moment pour rouvrir les paramètres.</sys:String>

    <sys:String x:Key="Notice.UpdateAvailable">La version {0} est disponible. Ouvrez les paramètres pour mettre à jour.</sys:String>
</ResourceDictionary>
