    <sys:String x:Key="Picker.Done">Terminé</sys:String>
    <sys:String x:Key="Picker.Cancel">Annuler</sys:String>

    <sys:String x:Key="About.Description">Un utilitaire natif de la zone de notification Windows pour gérer les fenêtres, à commencer par le centrage de la fenêtre active.</sys:String>
