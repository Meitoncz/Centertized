    <sys:String x:Key="Action.center-active-window.Name">Centrer la fenêtre active</sys:String>
    <sys:String x:Key="Action.center-active-window.Description">Centre la fenêtre active sur son moniteur actuel.</sys:String>
    <sys:String x:Key="Action.toggle-maximize-active-window.Name">Agrandir/restaurer la fenêtre active</sys:String>
    <sys:String x:Key="Action.toggle-maximize-active-window.Description">Agrandit la fenêtre active ; un nouvel appui rétablit la taille et la position précédentes.</sys:String>

    <sys:String x:Key="General.StartWithWindows">Démarrer avec Windows</sys:String>
    <sys:String x:Key="General.StartMinimized">Démarrer réduit</sys:String>
    <sys:String x:Key="General.StartMinimized.Description">Ne pas afficher cette fenêtre au démarrage de l'application</sys:String>
    <sys:String x:Key="General.AutoCenter">Centrer automatiquement les nouvelles fenêtres</sys:String>
    <sys:String x:Key="General.AutoCenter.Description">Centre automatiquement chaque fenêtre nouvellement ouverte sur son moniteur</sys:String>
    <sys:String x:Key="General.RememberSizes">Mémoriser la taille des fenêtres</sys:String>
    <sys:String x:Key="General.RememberSizes.Description">Les fenêtres d'une application s'ouvrent à la dernière taille que vous leur avez donnée. Fonctionne avec le centrage automatique.</sys:String>
    <sys:String x:Key="General.RememberSizes.Forget">Oublier toutes les tailles</sys:String>
    <sys:String x:Key="General.RunAsAdmin">Exécuter en tant qu'administrateur</sys:String>
    <sys:String x:Key="General.RunAsAdmin.Description">Permet à Centertized de déplacer les fenêtres des applications exécutées en tant qu'administrateur. Windows demande une confirmation (UAC) et Centertized redémarre.</sys:String>
    <sys:String x:Key="General.Theme">Thème</sys:String>
    <sys:String x:Key="General.Theme.Description">Clair, sombre ou celui de Windows</sys:String>
