<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Translation (fr) - overlays the English base, missing keys fall back to English. -->

    <sys:String x:Key="Settings.Title">Paramètres de Centertized</sys:String>

    <sys:String x:Key="Section.Shortcuts">Raccourcis</sys:String>
