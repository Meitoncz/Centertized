    <sys:String x:Key="Exceptions.Choose">Choisir des applications…</sys:String>
    <sys:String x:Key="Exceptions.Empty">Aucune exception.</sys:String>
    <sys:String x:Key="Exceptions.Remove">Supprimer</sys:String>

    <sys:String x:Key="Picker.Title">Choisir des applications</sys:String>
