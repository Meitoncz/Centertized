<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Translation (pl) - overlays the English base, missing keys fall back to English. -->

    <sys:String x:Key="Settings.Title">Ustawienia Centertized</sys:String>

    <sys:String x:Key="Section.Shortcuts">Skróty</sys:String>
    <sys:String x:Key="Section.AutoCenter">Automatyczne wyśrodkowanie</sys:String>
