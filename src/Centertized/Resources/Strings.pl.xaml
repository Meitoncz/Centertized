    <sys:String x:Key="Update.Available">Dostępna jest wersja {0}.</sys:String>
    <sys:String x:Key="Update.Download">Pobierz i uruchom ponownie</sys:String>
    <sys:String x:Key="Update.Downloading">Pobieranie…</sys:String>
    <sys:String x:Key="Update.Failed">Nie udało się sprawdzić aktualizacji.</sys:String>
    <sys:String x:Key="Update.NotInstalled">Aktualizacje działają tylko w zainstalowanej wersji Centertized.</sys:String>

