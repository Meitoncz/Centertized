    <sys:String x:Key="Hotkey.UsedElsewhere">Używane przez inną aplikację</sys:String>

    <sys:String x:Key="Tray.Open">Otwórz Centertized</sys:String>
    <sys:String x:Key="Tray.About">Informacje</sys:String>
    <sys:String x:Key="Tray.Close">Zamknij</sys:String>
    <sys:String x:Key="Tray.StillRunning">Nadal działa w zasobniku. Kliknij ikonę w dowolnym momencie, aby ponownie otworzyć ustawienia.</sys:String>

    <sys:String x:Key="Notice.UpdateAvailable">Dostępna jest wersja {0}. Otwórz ustawienia, aby zaktualizować.</sys:String>
