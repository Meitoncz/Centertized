<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Translation (zh) - overlays the English base, missing keys fall back to English. -->

    <sys:String x:Key="Settings.Title">Centertized 设置</sys:String>

    <sys:String x:Key="Section.Shortcuts">快捷键</sys:String>
    <sys:String x:Key="Section.AutoCenter">自动居中</sys:String>
    <sys:String x:Key="Section.Exceptions">自动居中的例外</sys:String>
    <sys:String x:Key="Section.General">常规</sys:String>
    <sys:String x:Key="Section.About">关于</sys:String>

    <sys:String x:Key="Action.center-active-window.Name">将活动窗口居中</sys:String>
    <sys:String x:Key="Action.center-active-window.Description">将当前活动窗口居中显示在其所在的显示器上。</sys:String>
    <sys:String x:Key="Action.toggle-maximize-active-window.Name">最大化/还原活动窗口</sys:String>
    <sys:String x:Key="Action.toggle-maximize-active-window.Description">最大化活动窗口；再次按下可还原到之前的大小和位置。</sys:String>

    <sys:String x:Key="General.StartWithWindows">随 Windows 启动</sys:String>
    <sys:String x:Key="General.StartMinimized">启动时最小化</sys:String>
    <sys:String x:Key="General.StartMinimized.Description">应用启动时不显示此窗口</sys:String>
    <sys:String x:Key="General.AutoCenter">自动居中新窗口</sys:String>
    <sys:String x:Key="General.AutoCenter.Description">自动将每个新打开的窗口居中显示在其所在的显示器上</sys:String>
    <sys:String x:Key="General.RememberSizes">记住窗口大小</sys:String>
    <sys:String x:Key="General.RememberSizes.Description">应用的窗口会以您上次设置的大小打开。与自动居中配合使用。</sys:String>
    <sys:String x:Key="General.RememberSizes.Forget">清除所有已记住的大小</sys:String>
    <sys:String x:Key="General.RunAsAdmin">以管理员身份运行</sys:String>
    <sys:String x:Key="General.RunAsAdmin.Description">让 Centertized 能够移动以管理员身份运行的应用的窗口。Windows 会请求确认 (UAC)，Centertized 将重新启动。</sys:String>
    <sys:String x:Key="General.Theme">主题</sys:String>
    <sys:String x:Key="General.Theme.Description">浅色、深色或跟随 Windows</sys:String>
    <sys:String x:Key="General.Theme.System">跟随系统</sys:String>
    <sys:String x:Key="General.Theme.Light">浅色</sys:String>
    <sys:String x:Key="General.Theme.Dark">深色</sys:String>
    <sys:String x:Key="General.Language">语言</sys:String>
    <sys:String x:Key="General.Language.Description">应用语言</sys:String>
    <sys:String x:Key="General.Language.System">跟随系统</sys:String>

    <sys:String x:Key="Exceptions.Intro">这些应用的新窗口不会自动居中。</sys:String>
    <sys:String x:Key="Exceptions.Choose">选择应用…</sys:String>
    <sys:String x:Key="Exceptions.Empty">没有例外。</sys:String>
    <sys:String x:Key="Exceptions.Remove">移除</sys:String>

    <sys:String x:Key="Picker.Title">选择应用</sys:String>
    <sys:String x:Key="Picker.Hint">勾选的应用将不参与自动居中。</sys:String>
    <sys:String x:Key="Picker.Search">搜索应用</sys:String>
    <sys:String x:Key="Picker.Done">完成</sys:String>
    <sys:String x:Key="Picker.Cancel">取消</sys:String>

    <sys:String x:Key="About.Description">一款用于窗口管理的 Windows 原生托盘工具，首先提供活动窗口居中功能。</sys:String>
    <sys:String x:Key="About.Version">版本 {0}</sys:String>
    <sys:String x:Key="About.Title">关于 Centertized</sys:String>
    <sys:String x:Key="About.License">许可证：GPLv3</sys:String>
    <sys:String x:Key="About.Close">关闭</sys:String>

    <sys:String x:Key="Update.Title">更新</sys:String>
    <sys:String x:Key="Update.Automatic">自动检查更新</sys:String>
    <sys:String x:Key="Update.Automatic.Description">应用启动时检查是否有新版本</sys:String>
    <sys:String x:Key="Update.Check">检查更新</sys:String>
    <sys:String x:Key="Update.Checking">正在检查…</sys:String>
    <sys:String x:Key="Update.UpToDate">您使用的已是最新版本。</sys:String>
    <sys:String x:Key="Update.Available">版本 {0} 可用。</sys:String>
    <sys:String x:Key="Update.Download">下载并重启</sys:String>
    <sys:String x:Key="Update.Downloading">正在下载…</sys:String>
    <sys:String x:Key="Update.Failed">无法检查更新。</sys:String>
    <sys:String x:Key="Update.NotInstalled">更新仅在已安装的 Centertized 中可用。</sys:String>

    <sys:String x:Key="Hotkey.NotSet">未设置</sys:String>
    <sys:String x:Key="Hotkey.NeedsModifier">需要 Ctrl/Alt/Shift/Win</sys:String>
    <sys:String x:Key="Hotkey.UsedBy">已被 {0} 使用</sys:String>
    <sys:String x:Key="Hotkey.UsedElsewhere">已被其他应用使用</sys:String>

    <sys:String x:Key="Tray.Open">打开 Centertized</sys:String>
    <sys:String x:Key="Tray.About">关于</sys:String>
    <sys:String x:Key="Tray.Close">退出</sys:String>
    <sys:String x:Key="Tray.StillRunning">仍在托盘中运行。随时点击图标即可重新打开设置。</sys:String>

    <sys:String x:Key="Notice.UpdateAvailable">版本 {0} 可用。请打开设置进行更新。</sys:String>
</ResourceDictionary>
