<ui:FluentWindow x:Class="Centertized.Views.AboutWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource About.Title}"
                 Width="440" Height="400"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource About.Title}"
                     ShowMinimize="False" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="32,8,32,24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Resources/centertized_icon.png"
                   Width="96" Height="96" HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <ui:TextBlock Margin="0,16,0,0" HorizontalAlignment="Center"
                          FontTypography="Title" Text="Centertized" />
            <ui:TextBlock x:Name="VersionText" Margin="0,4,0,0" HorizontalAlignment="Center"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <ui:TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                          TextWrapping="Wrap" MaxWidth="340"
                          Text="{DynamicResource About.Description}" />
            <ui:TextBlock Margin="0,12,0,0" HorizontalAlignment="Center"
                          Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="{DynamicResource About.License}" />
            <ui:HyperlinkButton x:Name="RepositoryLink" Margin="0,4,0,0" HorizontalAlignment="Center" />
            <Button Margin="0,16,0,0" HorizontalAlignment="Center" MinWidth="96"
                    Content="{DynamicResource About.Close}" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
