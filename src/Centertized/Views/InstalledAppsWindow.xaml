<ui:FluentWindow x:Class="Centertized.Views.InstalledAppsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:Centertized.Controls"
                 Title="{DynamicResource Picker.Title}"
                 Width="560" Height="640"
                 MinWidth="420" MinHeight="420"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{DynamicResource Picker.Title}" ShowMinimize="False" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="24,8,24,12">
            <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                          Text="{DynamicResource Picker.Hint}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <ui:TextBox x:Name="SearchBox" PlaceholderText="{DynamicResource Picker.Search}"
                        TextChanged="SearchBox_TextChanged" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="24,0,24,0">
            <ui:ProgressRing x:Name="LoadingRing" IsIndeterminate="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ListBox x:Name="AppsListBox" Visibility="Collapsed"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     controls:SmoothScrollBehavior.Enable="True"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="4,2" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="24" Height="24" Margin="0,0,10,0">
                                    <Image Source="{Binding Icon}" Width="24" Height="24"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <ui:SymbolIcon Symbol="AppGeneric24" FontSize="20"
                                                   Visibility="{Binding NoIconVisibility}" />
                                </Grid>
                                <ui:TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,12,24,20">
            <Button MinWidth="96" Content="{DynamicResource Picker.Cancel}" Click="CancelButton_Click" />
            <ui:Button Margin="8,0,0,0" MinWidth="96" Appearance="Primary"
                       Content="{DynamicResource Picker.Done}" Click="DoneButton_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
