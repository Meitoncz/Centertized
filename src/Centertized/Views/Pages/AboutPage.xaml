<Page x:Class="Centertized.Views.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="About">
    <StackPanel Margin="24">
        <TextBlock Text="Centertized" FontSize="20" FontWeight="SemiBold" />
        <TextBlock x:Name="VersionText" Opacity="0.7" Margin="0,4,0,0" />
        <TextBlock Text="A native Windows tray utility for window management, starting with active-window centering."
                   TextWrapping="Wrap" Margin="0,16,0,0" />
    </StackPanel>
</Page>
