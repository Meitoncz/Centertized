<ui:FluentWindow x:Class="Centertized.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:Centertized.Controls"
                 Title="{DynamicResource Settings.Title}"
                 Height="620" Width="760"
                 MinHeight="420" MinWidth="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <!-- Výchozí CornerRadius karet je moc malý/hranatý oproti referenci
             (Windows Nastavení apod.) - implicitní styl přebíjí na zaoblenější.
             UseLayoutRounding=False, jinak při zlomkovém DPI scale (125 % apod.)
             WPF snapuje hrany na celé pixely a zaoblený roh vyjde "schodovitě". -->
        <Style TargetType="{x:Type ui:CardControl}" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="UseLayoutRounding" Value="False" />
        </Style>
        <Style TargetType="{x:Type ui:CardExpander}" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="UseLayoutRounding" Value="False" />
        </Style>
    </ui:FluentWindow.Resources>
    <!-- Žádný NavigationView - pro appku téhle velikosti je sidebar zbytečný
         a navíc je NavigationView přímý spouštěč potvrzeného, dosud neopraveného
         WPF-UI bugu při živém přebarvení (lepoco/wpfui#1639). Jedna scrollovatelná
         stránka se sekcemi - stejný vzorec jako oficiální WPF-UI Gallery SettingsPage. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Centertized">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      controls:SmoothScrollBehavior.Enable="True">
            <StackPanel Margin="24,12,24,24">

                <ui:TextBlock Margin="0,0,0,8" FontTypography="BodyStrong" Text="{DynamicResource Section.Shortcuts}" />
                <ItemsControl x:Name="ActionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Keyboard24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding Name}" />
                                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                      Text="{Binding Description}"
                                                      TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <controls:HotkeyCaptureControl Tag="{Binding Id}"
                                                                Loaded="OnCaptureControlLoaded"
                                                                HotkeyCaptured="OnHotkeyCaptured" />
                            </ui:CardControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:TextBlock Margin="0,24,0,8" FontTypography="BodyStrong" Text="{DynamicResource Section.General}" />
                <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Power24}">
                    <ui:CardControl.Header>
                        <ui:TextBlock FontTypography="Body" Text="{DynamicResource General.StartWithWindows}" />
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="StartWithWindowsToggle"
                                     Checked="StartWithWindowsToggle_Toggled"
                                     Unchecked="StartWithWindowsToggle_Toggled" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon ArrowMinimize24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="{DynamicResource General.StartMinimized}" />
                            <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                          Text="{DynamicResource General.StartMinimized.Description}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="StartMinimizedToggle"
                                     Checked="StartMinimizedToggle_Toggled"
                                     Unchecked="StartMinimizedToggle_Toggled" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon AlignCenterHorizontal24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="{DynamicResource General.AutoCenter}" />
                            <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                          Text="{DynamicResource General.AutoCenter.Description}"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="AutoCenterNewWindowsToggle"
                                     Checked="AutoCenterNewWindowsToggle_Toggled"
                                     Unchecked="AutoCenterNewWindowsToggle_Toggled" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Resize24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="{DynamicResource General.RememberedSizes}" />
                            <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                          Text="{DynamicResource General.RememberedSizes.Description}"
                                          TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="RememberedSizesToggle"
                                     Checked="RememberedSizesToggle_Toggled"
                                     Unchecked="RememberedSizesToggle_Toggled" />
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon WeatherSunny24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="{DynamicResource General.Theme}" />
                            <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                          Text="{DynamicResource General.Theme.Description}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="ThemeModeCombo" MinWidth="160"
                              SelectionChanged="ThemeModeCombo_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource General.Theme.System}" />
                        <ComboBoxItem Content="{DynamicResource General.Theme.Light}" />
                        <ComboBoxItem Content="{DynamicResource General.Theme.Dark}" />
                    </ComboBox>
                </ui:CardControl>
                <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon LocalLanguage24}">
                    <ui:CardControl.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="Body" Text="{DynamicResource General.Language}" />
                            <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                          Text="{DynamicResource General.Language.Description}" />
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ComboBox x:Name="LanguageCombo" MinWidth="160"
                              SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource General.Language.System}" />
                        <ComboBoxItem Content="English" />
                        <ComboBoxItem Content="Čeština" />
                    </ComboBox>
                </ui:CardControl>

                <ui:TextBlock Margin="0,24,0,8" FontTypography="BodyStrong" Text="{DynamicResource Section.Apps}" />
                <ui:TextBlock Margin="0,0,0,12"
                              Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                              Text="{DynamicResource Apps.Intro}"
                              TextWrapping="Wrap" />
                <ui:TextBlock x:Name="AppsEmptyText" Margin="0,0,0,12"
                              Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                              Text="{DynamicResource Apps.Empty}" />
                <ItemsControl x:Name="AppsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon AppGeneric24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding DisplayName}" />
                                        <ui:TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                                      Text="{Binding SizeText}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                                                  Text="{DynamicResource Apps.AutoCenter}" />
                                    <ui:ToggleSwitch Tag="{Binding Key}" IsChecked="{Binding AutoCenterEnabled, Mode=OneWay}"
                                                     Checked="AppAutoCenterToggle_Toggled"
                                                     Unchecked="AppAutoCenterToggle_Toggled" />
                                    <Button Margin="12,0,0,0" Tag="{Binding Key}"
                                            Content="{DynamicResource Apps.ForgetSize}"
                                            IsEnabled="{Binding HasSize}"
                                            Click="AppForgetSize_Click" />
                                    <Button Margin="8,0,0,0" Tag="{Binding Key}"
                                            Content="{DynamicResource Apps.Remove}"
                                            Click="AppRemove_Click" />
                                </StackPanel>
                            </ui:CardControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="AddRunningAppButton" Margin="0,0,0,12"
                        Content="{DynamicResource Apps.AddRunning}"
                        Click="AddRunningAppButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="RunningAppsMenu" />
                    </Button.ContextMenu>
                </Button>

                <ui:TextBlock Margin="0,24,0,8" FontTypography="BodyStrong" Text="{DynamicResource Section.About}" />
                <ui:CardExpander Icon="{ui:SymbolIcon Info24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong" Text="Centertized" />
                            <ui:TextBlock x:Name="VersionText" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <ui:TextBlock Margin="0,0,0,8"
                                  Text="{DynamicResource About.Description}"
                                  TextWrapping="Wrap" />
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
